{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TheCaseTableAndItsIndex",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:BatchWriteItem",
        "dynamodb:BatchGetItem",
        "dynamodb:TransactWriteItems",
        "dynamodb:TransactGetItems",
        "dynamodb:ConditionCheckItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:699073937307:table/panchayat",
        "arn:aws:dynamodb:us-east-1:699073937307:table/panchayat/index/GSI1"
      ]
    },
    {
      "Sid": "ModelsOnceTheAccountClears",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/*",
        "arn:aws:bedrock:*:699073937307:inference-profile/*"
      ]
    },
    {
      "Sid": "TheRuntimeCreatesTheFirstWake",
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateSchedule",
        "scheduler:GetSchedule",
        "scheduler:DeleteSchedule"
      ],
      "Resource": "arn:aws:scheduler:us-east-1:699073937307:schedule/default/pnc-*"
    },
    {
      "Sid": "AndHandsEventBridgeTheRoleThatInvokesTheWatchdog",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::699073937307:role/panchayat-scheduler",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "scheduler.amazonaws.com"
        }
      }
    }
  ]
}
