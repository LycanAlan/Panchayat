# ---- copy to .env and fill in. .env is gitignored. ----

AWS_REGION=us-east-1
AWS_PROFILE=panchayat

# Time. 1 = production. 86400 = one statutory day per real second (demo).
TIME_SCALE=1

# DynamoDB
PANCHAYAT_TABLE=panchayat

# Bedrock model ids -- CONFIRM THESE IN THE CONSOLE ON DAY 1.
# They carry a region prefix and a wrong id is a 20-minute detour.
MODEL_SMALL=us.amazon.nova-lite-v1:0
MODEL_MID=us.anthropic.claude-haiku-4-5-20251001-v1:0
MODEL_LARGE=
MODEL_EMBED=amazon.titan-embed-text-v2:0

# Institution A2A endpoints (local dev)
WARD_ENDPOINT=http://localhost:9001
WATER_ENDPOINT=http://localhost:9002
SCHOOL_ENDPOINT=http://localhost:9003
VENDOR_ENDPOINT=http://localhost:9004

# Filled in after Ali deploys the scheduler + watchdog lambda
WATCHDOG_LAMBDA_ARN=
SCHEDULER_ROLE_ARN=

# Clustering threshold. Swept by eval/tau_sweep.py -- do not guess.
TAU=0.72
